# Copie para dotenv_files/.env apenas no servidor. Nunca versione esse arquivo.
# Gere uma chave nova, por exemplo:
# python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY="SUBSTITUA_POR_UMA_CHAVE_ALEATORIA_LONGA_E_EXCLUSIVA"
DEBUG="0"
DJANGO_ENV="production"

# Troque pelo domínio real, sem protocolo e sem barras.
ALLOWED_HOSTS="blog.exemplo.com"
CSRF_TRUSTED_ORIGINS="https://blog.exemplo.com"

# O Nginx deve terminar o HTTPS e encaminhar X-Forwarded-Proto corretamente.
TRUST_X_FORWARDED_PROTO="1"
SECURE_SSL_REDIRECT="1"
SESSION_COOKIE_SECURE="1"
CSRF_COOKIE_SECURE="1"

# Só habilite includeSubDomains/preload se TODOS os subdomínios usam HTTPS.
SECURE_HSTS_SECONDS="31536000"
SECURE_HSTS_INCLUDE_SUBDOMAINS="0"
SECURE_HSTS_PRELOAD="0"

GUNICORN_WORKERS="3"

DB_ENGINE="django.db.backends.postgresql"
POSTGRES_DB="SUBSTITUA"
POSTGRES_USER="SUBSTITUA"
POSTGRES_PASSWORD="SUBSTITUA_POR_UMA_SENHA_FORTE"
POSTGRES_HOST="psql"
POSTGRES_PORT="5432"
